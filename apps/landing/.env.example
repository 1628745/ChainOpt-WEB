# Supabase project that holds the `waitlist` table (see supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin used for canonical URLs, sitemap, and social card images.
# Vercel production builds fall back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Scheduling link shown beneath the early-access form (Cal.com, Calendly, ...).
# Leave empty to hide the divider and the "book a walkthrough" button entirely.
NEXT_PUBLIC_BOOKING_URL=
